{
  "BlastRadius": {
    "ControlPlaneUrl": "http://localhost:5188",
    "RedisConnectionString": "YOUR_UPSTASH_REDIS_CONNECTION_STRING",
    "Environment": "production",
    "PubSubChannel": "flag-updates",
    "EnableTelemetry": true,
    "TelemetryFlushIntervalMs": 1000
  },
  "Chaos": {
    "FailureRatePercent": 15.0,
    "SimulateLatencyMs": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
